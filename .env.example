# Terralink Platform API Base URL
# Set this to your backend server URL
NEXT_PUBLIC_TERRALINK_BASE_URL=http://localhost:8000

# JWT Cookie Name (optional, defaults to "ef_session")
# This should match the backend configuration
JWT_COOKIE_NAME=ef_session

# Leave unset for Secure cookies in production. Set false only for a private
# HTTP deployment; use true (or the production default) with HTTPS.
# JWT_COOKIE_SECURE=true

# Development Environment
NODE_ENV=development
